{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Universal Debug (万能 OpenOCD 方案)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",          
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/STM32H7_Gateway.elf", 
            "runToEntryPoint": "main",
            
            "searchDir": [
                "D:/app/openocd/share/openocd/scripts"
            ],
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32h7x.cfg"
            ],
            
            "serverpath": "D:/app/openocd/bin/openocd.exe",
            
            "armToolchainPath": "D:/app/VSCode/data/STM32CubeCLT_1.22.0/GNU-tools-for-STM32/bin",
            "gdbPath": "D:/app/VSCode/data/STM32CubeCLT_1.22.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe",
            
            "svdFile": "D:/app/VSCode/data/STM32CubeCLT_1.22.0/STMicroelectronics_CMSIS_SVD/STM32H753.svd",
            
            "preLaunchCommands": [
                "monitor reset halt"          
            ],
            
            "showDevDebugOutput": "raw"
        }
    ]
}